# Copy this file to .env and fill in your own values.
# The .env file is gitignored -- never commit real credentials.

# --- SMTP settings (Gmail example) ---
# For Gmail: enable 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_USE_TLS=true

# Where alert / digest mails are sent
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com

# --- Optional overrides ---
# Path to the watchlist file (default: watchlist.yaml next to where you run the CLI)
# LOOKOUT_WATCHLIST=watchlist.yaml
# Path to the SQLite database (default: lookout.db)
# LOOKOUT_DB=lookout.db
# Default polling interval in minutes for `lookout run` (default: 60)
# LOOKOUT_INTERVAL_MINUTES=60
